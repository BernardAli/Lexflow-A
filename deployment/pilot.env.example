# Copy to pilot.env with mode 0600. Supply unique secrets; never reuse demo keys.
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
LEXFLOW_MASTER_KEY=fernet:replace-with-a-generated-Fernet-key
DJANGO_ALLOWED_HOSTS=pilot.example.invalid
LEXFLOW_TENANT_SLUG=your-office
LEXFLOW_AI_PROVIDER=rules
LEXFLOW_OCR_ENABLED=1
LEXFLOW_OCR_LANGUAGES=deu+eng
# Operator-approved exact endpoints. HTTPS required; redirects are not followed.
LEXFLOW_WEBHOOK_ENDPOINTS={}
LEXFLOW_HOSTING_REGION=operator-confirmed-region
LEXFLOW_PUBLIC_HOST=pilot.example.invalid
DJANGO_TRUST_PROXY=1
# Password reset mail. Set each account's email address in Django admin.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=replace-with-the-smtp-account
EMAIL_HOST_PASSWORD=replace-with-the-smtp-secret
DEFAULT_FROM_EMAIL=LexFlow <noreply@example.invalid>
